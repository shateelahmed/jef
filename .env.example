# Absolute path of the directory to run jef in by default. A leading ~, $HOME or
# ${HOME} is expanded (eg. TARGET_DIR=~/code); nothing else is.
TARGET_DIR=
# The default branch (eg. main): `jef sync` pulls it and brings it into every other branch; `jef merged` and
# `jef delete` use it too.
DEFAULT_BRANCH=
# Branches `jef merged` never lists or deletes (names or glob patterns, comma separated, eg.
# release/*). The default branch and origin's HEAD branch are always protected.
PROTECTED_BRANCHES=dev,qa,staging,uat
# Directory names every command skips, comma separated (eg. archived,playground).
SKIP_DIRS=
# Commands for `jef migrate`: "<repository directory name>:<command>" entries separated by ';'.
# A ';' inside quotes belongs to the command. Repositories without an entry are skipped.
# Commands get no terminal input. For Docker use "docker exec <container> ..." without -it; it finds the
# container by name, so the compose file location does not matter (the container must be running).
# MIGRATE_CMDS="order-service:docker exec order-app php artisan migrate --force; user-service:docker exec user-app npm run migrate"
MIGRATE_CMDS=
